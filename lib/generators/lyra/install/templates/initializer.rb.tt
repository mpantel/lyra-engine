# frozen_string_literal: true

# Lyra (generated by `bin/rails generate lyra:install`). The settings are in
# the API reference; the path from an existing application, mode by mode, is
# in the Migration Guide.
Lyra.configure do |config|
  # Start in Monitor (non-intrusive; also the default).
  config.mode = :monitor

  # Optional: the engine uses RailsEventStore::Client.new when none is set. If
  # you configure a JSON serializer, use Lyra::EventSerializer, not JSON: JSON
  # drops fractional seconds from times.
  # config.event_store = RailsEventStore::Client.new(
  #   repository: RubyEventStore::ActiveRecord::EventRepository.new(serializer: Lyra::EventSerializer)
  # )

  # Optional: monitor models without editing them (or add monitor_with_lyra to each).
  # config.models = %w[Order Customer]

  # Optional: who made each change, merged into every event's metadata.
  # config.metadata_proc = ->(record, operation) { { user_id: Current.user&.id } }
end
