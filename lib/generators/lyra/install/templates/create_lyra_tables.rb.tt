# frozen_string_literal: true

# Lyra's own tables, and the index on Rails Event Store's
# event_store_events_in_streams that serves Lyra's backward reads by id.
# Generated by `bin/rails generate lyra:install`.
#
# Without this migration Lyra creates each table the first time it needs it,
# and it still does wherever one is missing. Every statement here is "if not
# exists": where Lyra already created a table at run time, it is left as it is,
# and a mode-transitions table created by an earlier version gets the columns
# later versions added, as Lyra would add them at run time.
class CreateLyraTables < ActiveRecord::Migration[<%= migration_version %>]
