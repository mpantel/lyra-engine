    transaction do
      create_table :lyra_async_checkpoints, id: false, if_not_exists: true do |t|
        t.string :stream, null: false
        t.string :event_id, null: false
        t.datetime :updated_at
      end
      add_index :lyra_async_checkpoints, :stream, unique: true, if_not_exists: true
    end

    # Data-subject requests: restrictions and objections (Lyra::Rights::Store).
    transaction do
      create_table :lyra_rights, if_not_exists: true do |t|
        t.string :request_id, limit: 36, null: false
