      add_column :lyra_mode_transitions, :host, :string, if_not_exists: true
      add_column :lyra_mode_transitions, :pid, :integer, if_not_exists: true
      add_column :lyra_mode_transitions, :forced, :boolean, null: false, default: false, if_not_exists: true
      add_column :lyra_mode_transitions, :certificate_id, :bigint, if_not_exists: true
      add_column :lyra_mode_transitions, :started_at, :datetime, if_not_exists: true
      add_column :lyra_mode_transitions, :seen_at, :datetime, if_not_exists: true
      add_column :lyra_mode_transitions, :ended_at, :datetime, if_not_exists: true
