source "https://rubygems.org"

ruby ">= 3.4.5"

gem "rails", "8.1.4" # the version the engine is tested with
gem "pg", "~> 1.1"

# PetriFlow (optional for Lyra, verification). Lyra's rake tasks eager load the
# engine, whose app/workflows need it, so lyra:repair and lyra:genesis fail
# without it. Listed before Lyra so Lyra finds it loaded.
gem "orfeas_petri_flow", path: "../../gems/petri_flow", require: "petri_flow"
gem "rexml" # petri_flow needs it but does not declare it (not a default gem since Ruby 3.4)

# Lyra, from this checkout (the gem is orfeas_lyra, its entry file lyra.rb).
# glob: ../.. may also hold another checkout of the engine with a
# lyra.gemspec of its own. Bundler's default search ({,*,*/*}.gemspec) would
# evaluate both, loading two lib/lyra/version.rb files ("already initialized
# constant Lyra::VERSION"). Only the root's.
gem "orfeas_lyra", path: "../..", glob: "lyra.gemspec", require: "lyra"

# RailsEventStore 3 stores Lyra's events.
gem "rails_event_store", "~> 3.2.0" # Lyra needs ~> 3.0; 3.2 is what the engine is tested with

# Rails 8.1 still calls JSON.parse(source, options) with a positional options
# hash, which json 3 removed. Stay on json 2 until Rails supports 3.
gem "json", "< 3"

group :development, :test do
  gem "debug", platforms: %i[mri windows], require: "debug/prelude"
end
